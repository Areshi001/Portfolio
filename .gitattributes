# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text diff=python
*.pyw text
*.pyx text
*.pxd text
*.ipynb text

# JavaScript / TypeScript / Web
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.html text
*.htm text
*.svg text

# Config / Data / Docs
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.conf text
*.md text
*.txt text
*.tex text
*.bib text
*.csv text

# Environment
.env text
.env.example text
.env.* text

# Git
.gitignore text
.gitattributes text
.gitmodules text

# Docker
Dockerfile text
Dockerfile.* text
.dockerignore text

# Shell scripts — always LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Makefile
Makefile text
makefile text
*.mk text

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyc binary
*.pyo binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
